<?xml version="1.0" encoding="utf-8"?>
<!-- Most IPTV servers only offer plain HTTP, so cleartext must be allowed for user-added sources. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
